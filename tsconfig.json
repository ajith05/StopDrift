{
  // Editor-facing config: the permissive superset, so every file in the repo
  // resolves in an IDE. It is NOT what `npm run typecheck` uses.
  //
  // The real check is three passes - tsconfig.worker.json, tsconfig.ui.json and
  // tsconfig.tests.json - which differ in `lib` so that background code is
  // checked WITHOUT the DOM. This config has the DOM available everywhere, so a
  // `document` reference in the service worker looks fine here and still fails
  // the typecheck. Run `npm run typecheck` before trusting a clean editor.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vitest/globals"],
    "allowJs": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.d.ts", "scripts/**/*.mjs"]
}
