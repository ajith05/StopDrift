{
  "manifest_version": 3,
  "name": "StopDrift",
  "version": "1.2.0",
  "description": "Local-only website blocker with deliberate typing friction. No accounts, no tracking, no network requests.",
  "minimum_chrome_version": "123",
  "permissions": ["storage", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "split",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StopDrift",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "styles.css"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": false
    }
  ]
}
